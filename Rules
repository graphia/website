#!/usr/bin/env ruby

# HTML (Slim)
compile '/index.slim' do
  filter :slim
  filter :rubypants
  layout '/default.*'
  write '/index.html'
end

compile '/**/*.slim' do
  filter :slim
  filter :rubypants
  layout '/default.*'
  write item.identifier.without_ext + '/index.html'
end

# Everything else
compile '/**/*' do
  write item.identifier.to_s
end

# Layouts
layout '/**/*', :slim
